# Augusta Terminal configuration. Copy this file to ".env" and edit.
# Lines starting with # are ignored. Never commit .env or share it.

# ---- Mode ---------------------------------------------------------------
# live = real market data.  demo = simulated prices (no internet needed).
DATA_MODE=live

# ---- Server -------------------------------------------------------------
# 127.0.0.1 = only this computer. Use 0.0.0.0 only behind a VPN / private network.
HOST=127.0.0.1
PORT=8000
# Set to 1 when the site is served over HTTPS (marks the login cookie Secure).
AUGUSTA_HTTPS=0
# First-run admin account. If ADMIN_PASSWORD is empty a random one is printed once.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ---- Data providers (all optional; blank = fall back to free sources) ----
# Twelve Data: real-time US equities, FX, crypto.  https://twelvedata.com
TWELVEDATA_API_KEY=
# 1 = also open the Twelve Data WebSocket stream (needs the Pro plan or higher).
TWELVEDATA_STREAM=0
# Massive (formerly Polygon.io) Options plan: option chains with vendor greeks.
MASSIVE_API_KEY=
# Finnhub (free key): market news and the market-wide earnings calendar.
FINNHUB_API_KEY=
# FRED (free key): official API for yields, credit spreads, macro release dates.
FRED_API_KEY=

# Seconds between quote refreshes. Lower = fresher but more API credits.
QUOTE_TTL=5
# Seconds between alarm checks.
ALERT_POLL_SECONDS=15

# ---- Alarm notifications ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Team channel webhooks (either or both).
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Paper trading --------------------------------------------------------
# Pretend capital each account starts with, the gross-exposure limit (x equity),
# and the commission on stocks, ETFs, crypto and bonds in basis points of trade value.
PAPER_START_CASH=1000000
PAPER_MAX_LEVERAGE=5
PAPER_COMMISSION_BPS=1
